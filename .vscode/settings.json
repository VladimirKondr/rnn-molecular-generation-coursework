{
    "latex-workshop.latex.autoBuild.onSave.files.ignore": [
        "**/*.sty",
        "**/*.cls",
        "**/*.tex"
    ],

    "latex-workshop.latex.clean.fileTypes": [
        "*.aux",
        "*.bbl",
        "*.blg",
        "*.idx",
        "*.ind",
        "*.lof",
        "*.lot",
        "*.out",
        "*.toc",
        "*.acn",
        "*.acr",
        "*.alg",
        "*.glg",
        "*.glo",
        "*.gls",
        "*.ist",
        "*.fls",
        "*.fdb_latexmk",
        "*.synctex.gz",
        "*.bcf",
        "*.run.xml"
    ],

    "latex-workshop.latex.tools": [
        {
            "name": "xelatex",
            "command": "xelatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-output-directory=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "biber",
            "command": "biber",
            "args": [
                "--output-directory=%OUTDIR%",
                "--input-directory=%OUTDIR%",
                "%DOCFILE%"
            ]
        }
    ],

    "latex-workshop.latex.recipes": [
        {
            "name": "xelatex -> biber -> xelatex*2",
            "tools": [
                "xelatex",
                "biber",
                "xelatex",
                "xelatex"
            ]
        }
    ],

    // Устанавливаем наш рецепт как рецепт по умолчанию для сборки.
    "latex-workshop.latex.recipe.default": "xelatex -> biber -> xelatex*2",

    // Настройки для просмотра PDF
    "latex-workshop.view.pdf.viewer": "tab", // Открывать PDF во вкладке VS Code
    "latex-workshop.view.pdf.zoom": "auto"    // Масштаб по ширине страницы
}